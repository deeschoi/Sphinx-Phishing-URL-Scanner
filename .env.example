# Copy to .env (gitignored) and fill in. Real environment variables always win,
# so a container's own settings are never overridden by this file.
# Render does NOT load this file. Public-demo values live in render.yaml.

# --- Analyst chat -----------------------------------------------------------
# Chat is BYOK: the UI pastes a Groq key and sends it as X-Groq-Api-Key.
# GROQ_API_KEY is a local fallback only so you can chat without pasting.
# Render must OMIT this key so Groq bills the visitor, not you.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_TIMEOUT=45
# GROQ_MAX_TOOL_STEPS=5
# Local. render.yaml sets these to 5 and 1 on the public demo.
# SPHINX_CHAT_RATE_PER_MINUTE=30
# SPHINX_CHAT_MAX_CONCURRENT=1

# --- API protection ---------------------------------------------------------
# Leave unset for localhost and for the public demo. A key baked into the UI
# is not auth. Clients send it as X-API-Key (VITE_SPHINX_API_KEY at build time).
SPHINX_API_KEY=
# Local. render.yaml sets these to 8 and 2 on the public demo.
# SPHINX_SCAN_RATE_PER_MINUTE=20
# SPHINX_SCAN_MAX_CONCURRENT=4
# Localhost has no trusted proxy. render.yaml sets this to 1 because Render
# is the only ingress. Do not set 1 here.
# SPHINX_TRUST_PROXY_HEADERS=0

# --- Storage ----------------------------------------------------------------
# Default (and Render Free): SQLite at data/scans.db. Uncomment below only
# for: docker compose --profile postgres up
# PHISHING_DATABASE_URL=postgresql+psycopg2://phishing:CHANGE_ME@db:5432/phishing
# POSTGRES_USER=phishing
# POSTGRES_PASSWORD=CHANGE_ME
# POSTGRES_DB=phishing
