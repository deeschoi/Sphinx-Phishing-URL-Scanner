# Copy to .env (gitignored) and fill in. Real environment variables always win,
# so a container's own settings are never overridden by this file.
# Vercel does not load this file. The public site is the Vercel project;
# its values are in the dashboard (the commented block below).

# --- Analyst chat -----------------------------------------------------------
# Chat is BYOK: the UI pastes a Groq key and sends it as X-Groq-Api-Key.
# GROQ_API_KEY is a local fallback only so you can chat without pasting.
# The public site omits this key so Groq bills the visitor, not the operator.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_TIMEOUT=45
# GROQ_MAX_TOOL_STEPS=5
# Local. The public site sets these to 5 and 1.
# SPHINX_CHAT_RATE_PER_MINUTE=30
# SPHINX_CHAT_MAX_CONCURRENT=1

# --- API protection ---------------------------------------------------------
# Leave SPHINX_API_KEY unset for localhost. A key baked into the UI is not auth.
# Clients send it as X-API-Key (VITE_SPHINX_API_KEY at build time).
SPHINX_API_KEY=
# Who may call scan/chat/history/stats when no key is set:
#   loopback (default) — 127.0.0.0/8 and ::1 only. Localhost needs no change.
#   private            — also RFC1918 / ULA / link-local (LAN dev)
#   1 / true / all     — fully open (public demo opt-in)
#   0 / never          — anonymous never allowed
# SPHINX_ALLOW_ANONYMOUS=loopback
# Local. The public site sets these to 8 and 2.
# SPHINX_SCAN_RATE_PER_MINUTE=20
# SPHINX_SCAN_MAX_CONCURRENT=4
# Async job workers (Scanner and Batch poll these). Defaults to the concurrent cap.
# SPHINX_JOB_WORKERS=4
# How many jobs may wait behind the workers before enqueue returns 503.
# SPHINX_JOB_QUEUE_MAX=32
# SPHINX_BATCH_MAX_URLS=25
# OpenAPI at /docs. Leave unset; the schema describes an endpoint that fetches
# arbitrary URLs.
# SPHINX_ENABLE_DOCS=0
# Localhost has no trusted proxy. Set 1 only behind an ingress you control
# (the Vercel project does). Do not set 1 here.
# SPHINX_TRUST_PROXY_HEADERS=0
# How many right-most X-Forwarded-For hops belong to proxies you control.
# 1 is correct when a single reverse proxy is the only ingress.
# SPHINX_TRUSTED_PROXY_HOPS=1

# --- Storage ----------------------------------------------------------------
# Default: SQLite at data/scans.db. Uncomment below only for
# docker compose --profile postgres up. The public site uses Neon instead.
# PHISHING_DATABASE_URL=postgresql+psycopg2://phishing:CHANGE_ME@db:5432/phishing
# POSTGRES_USER=phishing
# POSTGRES_PASSWORD=CHANGE_ME
# POSTGRES_DB=phishing

# --- Vercel (Neon + Upstash) ------------------------------------------------
# Local and Docker leave these unset and keep the in-process
# limiter, the thread pool, and SQLite. The public Vercel project sets them.
# Never set GROQ_API_KEY or SPHINX_API_KEY there. VERCEL=1 does not open
# anonymous access; set the opt-in explicitly.
# SPHINX_ALLOW_ANONYMOUS=1
# SPHINX_SCAN_RATE_PER_MINUTE=8
# SPHINX_SCAN_MAX_CONCURRENT=2
# SPHINX_JOB_WORKERS=2
# SPHINX_CHAT_RATE_PER_MINUTE=5
# SPHINX_CHAT_MAX_CONCURRENT=1
# SPHINX_TRUST_PROXY_HEADERS=1
# SPHINX_TRUSTED_PROXY_HOPS=1
# SPHINX_RATE_LIMIT_BACKEND=redis
# REDIS_URL=rediss://default:CHANGE_ME@HOST:6379
# SPHINX_JOB_BACKEND=qstash
# Leave SPHINX_WORKER_URL unset. The function publishes to
# https://$VERCEL_URL/api/internal/scan-jobs/run, so a staged deploy calls
# itself instead of the previous production deployment.
# Tokens and signing keys are per region. Set the region's endpoint from the
# Upstash console with the token from the same page.
# QSTASH_URL=https://qstash-us-east-1.upstash.io
# QSTASH_TOKEN=
# QSTASH_CURRENT_SIGNING_KEY=
# QSTASH_NEXT_SIGNING_KEY=
# CRON_SECRET=
# Lease TTL matches vercel.json maxDuration so a killed instance cannot hold
# a scan slot forever.
# SPHINX_LEASE_TTL_SECONDS=60
# One thread per invocation. app.py sets this when it is unset.
# OMP_NUM_THREADS=1
# Neon: use the pooled connection string. Preview and Production are separate
# branches so a preview deploy never writes production telemetry. Migrations
# run from CI (alembic upgrade head), not on a request.
# PHISHING_DATABASE_URL=postgresql+psycopg2://phishing:CHANGE_ME@HOST/phishing?sslmode=require
